# heyBuddy AI EdTech Platform - Environment Variables Template
# Copy this file to .env and insert your actual API keys.

# 1. Google Gemini API Key (Model: Gemini 1.5 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. OpenAI API Key (Model: GPT-4o Deep Masterclass Engine)
OPENAI_API_KEY=your_openai_api_key_here

# 3. Sarvam AI API Key (Expressive Indian TTS Model: bulbul:v3)
SARVAM_API_KEY=your_sarvam_api_key_here

# 4. ElevenLabs Voice AI API Key (Ultra-Realistic Neural Voices)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# 5. DeepL Translation API Key (Contextual Translation)
DEEPL_API_KEY=your_deepl_api_key_here

# 6. HeyGen API Key (Virtual Teacher Stream & Avatars)
HEYGEN_API_KEY=your_heygen_api_key_here

# 7. Wolfram Alpha App ID (Short Answers & Computation)
WOLFRAM_APP_ID=your_wolfram_app_id_here
